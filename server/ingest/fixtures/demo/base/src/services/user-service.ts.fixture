import type { User } from "../types/user";
import { randomId } from "../utils/format";

export interface UserStore {
  save(user: User): Promise<void>;
  all(): readonly User[];
}

export class UserService {
  constructor(private readonly store: UserStore) {}

  async createUser(name: string): Promise<User> {
    const user = { id: randomId(), name, createdAt: new Date() };
    await this.store.save(user);
    return user;
  }

  count(): number {
    return this.store.all().length;
  }

  names(): readonly string[] {
    return this.store.all().map((u) => u.name);
  }

  newest(): User | undefined {
    return [...this.store.all()].sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())[0];
  }

  oldest(): User | undefined {
    return [...this.store.all()].sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime())[0];
  }

  findByName(name: string): User | undefined {
    return this.store.all().find((u) => u.name === name);
  }
}
